# Production / Railway template
# Copy values into Railway environment variables.
# Do not commit real secrets.

# Runtime
NODE_ENV=production
PORT=10000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Auth
# Use a long random value, minimum 32 characters.
JWT_SECRET=replace_with_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
# Task 4: deploy dormant first, then enable in the documented staged order.
AUTH_SESSION_ISSUANCE_ENABLED=false
AUTH_REFRESH_ENABLED=false
AUTH_RBAC_ENFORCEMENT_ENABLED=false
AUTH_LEGACY_TOKEN_ACCEPTED=true
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
ACCESS_TOKEN_SECRET=replace_with_separate_random_access_secret_at_least_32_chars
REFRESH_TOKEN_HMAC_SECRET=replace_with_separate_random_refresh_hmac_secret_at_least_32_chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_ISSUER=atithisarthi-api
AUTH_TOKEN_AUDIENCE=atithisarthi-web

# Public/admin origins
# FRONTEND_URL is the primary public hotel domain.
# FRONTEND_ORIGINS is optional and supports additional public hotel domains.
FRONTEND_URL=https://hotel-one.example.com
FRONTEND_ORIGINS=https://hotel-one.example.com,https://hotel-two.example.com
# Optional exact preview/staging aliases, comma-separated.
# The alias is trusted only for the hotel slug explicitly mapped here.
PUBLIC_TENANT_HOST_ALIASES=your-project.your-account.workers.dev=hotel-one
ADMIN_URL=https://admin.example.com

# Frontend runtime config
# These values must be HTTPS in production and are used to populate the static frontend runtime meta tags.
# Keep APP_API_BASE_URL aligned with APP_BACKEND_BASE_URL unless you intentionally split them.
APP_BACKEND_BASE_URL=https://api.example.com
APP_API_BASE_URL=https://api.example.com/api
APP_CONTACT_SHEET_URL=
# Set this explicitly for production. Recommended: false for real client launch so website orders do not bypass DB/tracking/staff flows on backend failure.
APP_ALLOW_ORDER_WHATSAPP_FALLBACK_ON_SAVE_FAILURE=false
# Set this explicitly for production. Recommended: true for first client launch while hotel operations still rely on WhatsApp handoff after verified online payment.
APP_OPEN_WHATSAPP_AFTER_VERIFIED_ONLINE_PAYMENT=true
APP_ROOM_COMBINED_CHECKOUT_FRONTEND_ENABLED=false

# QR tenant/order signing
QR_CONTEXT_SIGNING_SECRET=replace_with_long_random_qr_signing_secret
QR_CONTEXT_STRICT_REQUIRED=true

# Optional fallback used when hotel data is incomplete.
OWNER_WHATSAPP_NUMBER=

# Notifications
# Leave disabled if WhatsApp/manual ops are your primary workflow.
# If enabling email, set channel=email and provide all SMTP fields.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_CHANNEL=internal
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=

# Payment gateway
# Use live keys only in real production.
PAYMENT_GATEWAY_ENABLED=false
PER_HOTEL_PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_CURRENCY=INR
PAYMENT_ROUTE_TRANSFERS_ENABLED=false
# Enable only after the atomic checkout migration and staging verifier pass.
ROOM_COMBINED_CHECKOUT_ENABLED=false
TASK6_ROOM_CHECKOUT_FINALIZER_ENABLED=false
PAYMENT_ROUTE_TEST_HOTEL_SLUG=hotel-one
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_live_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Launch notes
# 1. If this workspace or repo has ever been shared, rotate JWT, SMTP, Supabase service role,
#    and Razorpay secrets before launch.
# 2. Run:
#    npm.cmd run verify:production-config
#    npm.cmd run verify:payment-gateway-readiness
# 3. Then execute backend/scripts/production-launch-smoke-test-runbook.md
