# Development template
# Use this file as a local development reference.
# For production/Railway, prefer backend/.env.production.example.
# Use NODE_ENV=production only on the deployed backend.
NODE_ENV=development
PORT=5000

# Supabase
# Required in every environment. Keep the service role key backend-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Restricted tenant PostgreSQL runtime (Task 3)
# Keep disabled until the two-tenant read-only verifier and route migration pass.
# Never reuse the service-role/Postgres connection here.
TENANT_RUNTIME_ENABLED=false
TENANT_RUNTIME_PUBLIC_HOTEL_ENABLED=false
TENANT_RUNTIME_PUBLIC_MENU_ENABLED=false
TENANT_RUNTIME_PUBLIC_GALLERY_ENABLED=false
TENANT_DATABASE_URL=postgresql://app_tenant_runtime.PROJECT_REF:replace_with_runtime_role_password@POOLER_HOST:5432/postgres?sslmode=verify-full
TENANT_DATABASE_POOL_MAX=10
TENANT_DATABASE_IDLE_TIMEOUT_MS=30000
TENANT_DATABASE_CONNECTION_TIMEOUT_MS=10000
TENANT_DATABASE_STATEMENT_TIMEOUT_MS=15000

# Local-only inputs for npm.cmd run verify:tenant-runtime-connection.
# Obtain two distinct canonical pairs from task3-runtime-test-identities.sql.
# Do not add these verifier-only values to Railway.
TASK3_RUNTIME_VERIFY_CONFIRM=
TASK3_TEST_TENANT_A_ID=
TASK3_TEST_PROPERTY_A_ID=
TASK3_TEST_PROPERTY_A_SLUG=
TASK3_TEST_TENANT_B_ID=
TASK3_TEST_PROPERTY_B_ID=
TASK3_TEST_PROPERTY_B_SLUG=
TASK3_RUNTIME_CONCURRENCY_ITERATIONS=10
TASK3_PUBLIC_HOTEL_VERIFY_CONFIRM=
TASK3_PUBLIC_ROUTE_CONCURRENCY_ITERATIONS=10
TASK3_PUBLIC_HOTEL_LIVE_BASE_URL=
TASK3_PUBLIC_HOTEL_LIVE_CONFIRM=

# Auth
# Required. Use a long random secret in production, at least 32 characters.
JWT_SECRET=replace_with_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Public/admin origins
# Local development examples are shown here. In production these must be HTTPS URLs.
FRONTEND_URL=http://localhost:5500
FRONTEND_ORIGINS=
# Optional exact public-host aliases: hostname=hotel-slug, comma-separated.
# Use this for a provider preview hostname without replacing the real hotel domain.
PUBLIC_TENANT_HOST_ALIASES=
ADMIN_URL=http://localhost:5500

# Frontend runtime config
# These values are used to populate the static frontend runtime meta tags during deploy prep.
# Keep APP_API_BASE_URL aligned with APP_BACKEND_BASE_URL unless you intentionally split them.
APP_BACKEND_BASE_URL=http://localhost:5000
APP_API_BASE_URL=http://localhost:5000/api
APP_CONTACT_SHEET_URL=
# Controls whether normal website orders may fall back to WhatsApp-only when backend save fails.
# true keeps the current manual fallback behavior. false blocks manual-only fallback and asks the user to retry.
APP_ALLOW_ORDER_WHATSAPP_FALLBACK_ON_SAVE_FAILURE=true
# Controls whether successful verified online payments should also open the hotel's WhatsApp handoff.
# Keep this false locally unless you are explicitly testing the paid-order handoff flow.
APP_OPEN_WHATSAPP_AFTER_VERIFIED_ONLINE_PAYMENT=false
APP_ROOM_COMBINED_CHECKOUT_FRONTEND_ENABLED=false

# QR tenant/order signing
# Keep QR_CONTEXT_SIGNING_SECRET empty only if you are not using signed QR flows yet.
QR_CONTEXT_SIGNING_SECRET=
QR_CONTEXT_STRICT_REQUIRED=false

# Optional fallback used when a hotel profile/record does not have an owner WhatsApp number yet.
OWNER_WHATSAPP_NUMBER=

# Notifications
# Leave disabled if WhatsApp/manual operations are your primary workflow.
# If enabling email, set channel=email and provide all SMTP fields.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_CHANNEL=internal
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=

# Payment gateway
# Development can use Razorpay test keys. Production must use live keys.
# If PAYMENT_GATEWAY_ENABLED=true in production, RAZORPAY_WEBHOOK_SECRET is required.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_CURRENCY=INR
# Keep this false until every target hotel has a tested Razorpay Route linked account.
PAYMENT_ROUTE_TRANSFERS_ENABLED=false
# Keep disabled until create-room-combined-checkout.sql passes staging verification.
ROOM_COMBINED_CHECKOUT_ENABLED=false
# Optional helper for npm.cmd run verify:payment-route-hotel.
PAYMENT_ROUTE_TEST_HOTEL_SLUG=hotel-example
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
PAYMENT_GATEWAY_TIMEOUT_MS=10000
# Keep false for the first Task 2B backend boot. Enable only for the controlled worker phase.
PAYMENT_WEBHOOK_WORKER_ENABLED=false
PAYMENT_WEBHOOK_WORKER_INTERVAL_MS=5000

# Production preflight
# Before launch, run from backend:
# npm.cmd run verify:production-config
# npm.cmd run verify:payment-gateway-readiness
