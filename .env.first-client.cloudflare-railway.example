# First client launch template
# Hosting shape:
# - Frontend static files uploaded to Cloudflare
# - Backend API deployed on Railway
#
# Copy these values into Railway production environment variables.
# Replace every example domain and placeholder before launch.

NODE_ENV=production
PORT=10000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Auth
JWT_SECRET=replace_with_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
# Task 4: use independent generated secrets; do not reuse JWT_SECRET.
AUTH_SESSION_ISSUANCE_ENABLED=false
AUTH_REFRESH_ENABLED=false
AUTH_RBAC_ENFORCEMENT_ENABLED=false
AUTH_LEGACY_TOKEN_ACCEPTED=true
ACCESS_TOKEN_SECRET=replace_with_separate_random_access_secret_at_least_32_chars
REFRESH_TOKEN_HMAC_SECRET=replace_with_separate_random_refresh_hmac_secret_at_least_32_chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_ISSUER=atithisarthi-api
AUTH_TOKEN_AUDIENCE=atithisarthi-web

# Public/admin domains
# FRONTEND_URL should be the main public Cloudflare domain for the hotel site.
# FRONTEND_ORIGINS should include any additional public domains that must be trusted.
FRONTEND_URL=https://hotel.yourdomain.com
FRONTEND_ORIGINS=https://hotel.yourdomain.com
# Keep the real hotel domain above. Map the exact Cloudflare preview hostname here.
# Format: hostname=hotel-slug (comma-separated for more exact aliases).
PUBLIC_TENANT_HOST_ALIASES=your-project.your-account.workers.dev=hotel-first-client
ADMIN_URL=https://admin.yourdomain.com

# Frontend runtime config
# APP_BACKEND_BASE_URL is the Railway backend hostname you want the static frontend to call.
# APP_API_BASE_URL should normally be the same host with /api appended.
APP_BACKEND_BASE_URL=https://my-projectbackendpaymentgateway-production.up.railway.app
APP_API_BASE_URL=https://my-projectbackendpaymentgateway-production.up.railway.app/api
APP_CONTACT_SHEET_URL=

# First-client order safety posture
# - false: normal website orders must save to DB before any WhatsApp handoff
# - true: verified online payments still continue into the hotel's WhatsApp operating flow
APP_ALLOW_ORDER_WHATSAPP_FALLBACK_ON_SAVE_FAILURE=false
APP_OPEN_WHATSAPP_AFTER_VERIFIED_ONLINE_PAYMENT=true
APP_ROOM_COMBINED_CHECKOUT_FRONTEND_ENABLED=false

# QR security
QR_CONTEXT_SIGNING_SECRET=replace_with_long_random_qr_signing_secret
QR_CONTEXT_STRICT_REQUIRED=true

# Optional fallback if a hotel record is missing its own WhatsApp number
OWNER_WHATSAPP_NUMBER=

# Notifications
# Keep internal/manual unless you have already tested SMTP delivery.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_CHANNEL=internal
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=

# Payment gateway
# Safer first launch option:
# PAYMENT_GATEWAY_ENABLED=false
#
# If online payment is going live for the first client, switch to:
# PAYMENT_GATEWAY_ENABLED=true
# and use real live Razorpay values below.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_CURRENCY=INR
PAYMENT_ROUTE_TRANSFERS_ENABLED=false
# Keep false for first launch until combined checkout has passed staging verification.
ROOM_COMBINED_CHECKOUT_ENABLED=false
PAYMENT_ROUTE_TEST_HOTEL_SLUG=hotel-first-client
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_live_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Launch sequence after setting these values:
# 1. npm.cmd run verify:production-config
# 2. npm.cmd run verify:first-client-launch-profile
# 3. npm.cmd run verify:payment-gateway-readiness   (only if PAYMENT_GATEWAY_ENABLED=true)
# 4. Stamp frontend files before Cloudflare upload:
#    $env:NODE_ENV='production'
#    $env:APP_BACKEND_BASE_URL='https://my-projectbackendpaymentgateway-production.up.railway.app'
#    $env:APP_API_BASE_URL='https://my-projectbackendpaymentgateway-production.up.railway.app/api'
#    $env:APP_CONTACT_SHEET_URL=''
#    $env:APP_ALLOW_ORDER_WHATSAPP_FALLBACK_ON_SAVE_FAILURE='false'
#    $env:APP_OPEN_WHATSAPP_AFTER_VERIFIED_ONLINE_PAYMENT='true'
#    npm.cmd run prepare:frontend-runtime-config
#    npm.cmd run verify:frontend-runtime-config
# 5. Upload the stamped frontend/ files to Cloudflare
# 6. Run the production smoke test runbook

